# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local git'e eklenmez.

# --- Veritabanı (PostgreSQL) ---
# Neon: Dashboard > Connect > "Pooled connection" adresi (host'unda -pooler geçer).
# Supabase: Connect > "Transaction pooler" (port 6543) adresi.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Opsiyonel: migration'lar için doğrudan (pooler'sız) bağlantı. Neon'un Vercel entegrasyonu bunu otomatik ekler.
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- Kimlik doğrulama (Better Auth) ---
# En az 32 karakter rastgele bir değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Uygulamanın adresi. Lokalde http://localhost:3000; Vercel'de boş bırakılabilir (otomatik algılanır).
BETTER_AUTH_URL="http://localhost:3000"
# Opsiyonel: doluysa kayıt olurken bu kod istenir (yabancıların hesap açmasını engeller).
REGISTRATION_CODE=""

# --- Medya veri kaynakları ---
# TMDB (film & dizi): https://www.themoviedb.org/settings/api — "API Key" veya "API Read Access Token" ikisi de olur.
TMDB_API_KEY=""
# Google Books (kitap): anahtarsız da çalışır ama paylaşımlı kota hızla dolar; ücretsiz anahtar önerilir.
GOOGLE_BOOKS_API_KEY=""
# Open Library (kitap, yedek kaynak) ve iTunes (podcast) anahtar istemez.
